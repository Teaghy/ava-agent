NODE_ENV=development
# 保留在 monorepo 根目录；server 和 web 配置从此处读取。
APP_MODE=mock
# 服务端应用预设：customer-service（默认客服）、knowledge（知识问答）、chat（自由聊天）。
# 这与 mock/live 模型及基础设施模式独立；切换后重启。
APP_PRESET=customer-service
# 可选：指定其他插件配置，路径相对项目根目录。生产请指向已构建的 JS。
# AVA_CONFIG=config/custom.mjs
# 插件管理的持久记录；只保存已成功应用的配置。
PLUGIN_STATE_PATH=data/plugins.json
# 构建产物损坏时临时开启，跳过插件自动恢复以便管理和排查。
PLUGIN_SAFE_MODE=false
# APP_MODE=live 自动启用外部基础设施；mock 模型联调真实 DB 时设置 external。
# INFRA_MODE=external
HOST=127.0.0.1
PORT=3000

# Harness 内置 Ops 维护插件，默认不开放。页面和管理 API 使用独立监听。
OPS_ENABLED=false
OPS_HOST=127.0.0.1
OPS_PORT=3001
# 独立维护凭证，不得复用业务 Token。插件管理要求 admin:true + managePlugins:true；排查要求 inspectRuns:true。
# OPS_API_KEYS={"replace-with-a-random-maintenance-token":{"tenantId":"platform","userId":"operator","permissions":["READ","WRITE"],"admin":true,"managePlugins":true}}
OPS_API_KEYS={}
# 只读排查示例（替换随机 Token）：
# OPS_API_KEYS={"replace-with-random-inspector-token":{"tenantId":"demo","userId":"reviewer","permissions":[],"inspectRuns":true}}
# 运行排查默认仅查看维护身份所属租户；跨租户须在该身份配置 inspectTenants: ["demo"]。

DATABASE_URL=postgres://ava:ava@localhost:5432/ava
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# 模型兼容能力：auto 按服务地址和模型匹配已知规则；Ops 保存后优先使用页面配置。
# message format: auto / preserve / single-system-first
LLM_MESSAGE_FORMAT=auto
# JSON output: auto / json-object / prompt（结果始终严格校验）
LLM_JSON_OUTPUT=auto
# stream usage: auto / enabled / disabled
LLM_STREAM_USAGE=auto
# live 模式将最终回答单独生成并实时输出；业务工具或额外审核策略会自动缓冲。
ANSWER_STREAMING=true
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# 单次向量请求的文本条数；百炼 text-embedding-v3/v4 上限 10，qwen3.7 系列上限 20。
EMBEDDING_BATCH_SIZE=10

MEM0_ENABLED=false
MEM0_URL=http://localhost:8888
MEM0_API_KEY=

# 可选本地账号登录；开启后提供同源 /admin/ 成员管理。首次设置见 docs/local-identity.md。
LOCAL_AUTH_ENABLED=false
# JSON，每人独立 Token；未开启本地登录且为空时，聊天和会话接口返回 401。勿提交实际 Token。
# 客户/业务端身份；admin 可维护知识内容，不能凭此访问 Ops。
# 每人生成随机值后填写；同公司用相同 tenantId，不同员工用不同 userId。
# API_KEYS={"replace-alice-token":{"tenantId":"demo","userId":"alice","permissions":["READ"]},"replace-bob-token":{"tenantId":"demo","userId":"bob","permissions":["READ"]}}
API_KEYS={}
# 设备/后台服务接入：应用身份与用户账号分开，多个设备可共用 knowledgeSpaceId。
# 每个 Key 随机生成，至少 32 字符；不能复用 API_KEYS / OPS_API_KEYS。启动时导入数据库。
# APPLICATION_KEYS={"replace-with-a-random-application-key":{"tenantId":"company-a","applicationId":"vcd86-device-a","knowledgeSpaceId":"vcd86"}}
# 可选权限：permissions 默认 ["READ"]，allowChat 默认 true，manageKnowledge 默认 false，expiresAt 可选 UTC 时间。
APPLICATION_KEYS={}
# 导入后以数据库为准，删除上面的 Key 不会撤销；到 /admin/“应用与凭证”在线撤销。
# 日常签发、轮换与停用在页面即时生效，不需重启。纯内存 mock 重启不保留管理状态。
SEED_KNOWLEDGE=true
SEED_TENANT_ID=demo
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=10
MAX_RAG_SEARCHES=3
CONTEXT_TOKEN_BUDGET=12000
RUN_TIMEOUT_MS=90000
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
