NODE_ENV=development
# 保留在 monorepo 根目录；server 和 web 配置从此处读取。
APP_MODE=mock
# 可选：指定其他插件配置，路径相对项目根目录。生产请指向已构建的 JS。
# AVA_CONFIG=config/custom.mjs
# 插件管理的持久记录；只保存已成功应用的配置。
PLUGIN_STATE_PATH=data/plugins.json
# 构建产物损坏时临时开启，跳过插件自动恢复以便管理和排查。
PLUGIN_SAFE_MODE=false
# APP_MODE=live 自动启用外部基础设施；mock 模型联调真实 DB 时设置 external。
# INFRA_MODE=external
HOST=127.0.0.1
PORT=3000

# Harness 内置 Ops 维护插件，默认不开放。页面和管理 API 使用独立监听。
OPS_ENABLED=false
OPS_HOST=127.0.0.1
OPS_PORT=3001
# 独立维护凭证，不能复用 API_KEYS 的 Token；要求 admin:true 与 managePlugins:true。
# OPS_API_KEYS={"replace-with-a-random-maintenance-token":{"tenantId":"platform","userId":"operator","permissions":["READ","WRITE"],"admin":true,"managePlugins":true}}
OPS_API_KEYS={}

DATABASE_URL=postgres://ava:ava@localhost:5432/ava
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

MEM0_ENABLED=false
MEM0_URL=http://localhost:8888
MEM0_API_KEY=

# JSON，Token 映射到服务端身份。live/production 必填，勿提交实际 Token。
# 客户/业务端身份；admin 可维护知识内容，不能凭此访问 Ops。
API_KEYS={}
SEED_KNOWLEDGE=true
SEED_TENANT_ID=demo
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=10
MAX_RAG_SEARCHES=3
CONTEXT_TOKEN_BUDGET=12000
RUN_TIMEOUT_MS=90000
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
