{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".ava",
    "types": ["node"],
    "noEmitOnError": true
  },
  "include": ["ava.config.ts", "extensions/**/*.ts"],
  "exclude": ["node_modules", ".ava"]
}
